{
  "name": "fleet-rental-bot",
  "version": "0.2.40",
  "private": true,
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "ensure-electron-runtime": "node node_modules/electron/install.js",
    "postinstall": "npm run ensure-electron-runtime",
    "test": "npm run build && node --test",
    "typecheck": "tsc --noEmit",
    "validate:release": "npm run build && node electron/validate-release-cli.js",
    "start": "npm run build && electron .",
    "dev:cli": "ts-node src/index.ts",
    "start:electron": "npm run build && electron .",
    "dev": "npm run start:electron"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.0",
    "@staratlas/anchor": "^0.25.1",
    "@staratlas/sage": "^1.8.6",
    "bn.js": "^5.2.1",
    "bs58": "^6.0.0",
    "electron": "^42.1.0",
    "rpc_limiter": "https://github.com/aephiaviktor/rpc-limiter/archive/b2db0cd36ff6f8b632dbb055d684dc6c34b735e9.tar.gz"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.6",
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2"
  }
}
